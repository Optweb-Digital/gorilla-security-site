{
  "extends": "@wordpress/stylelint-config",
  "rules": {
    "color-no-hex": [true, { "message": "Use a theme.json token (var(--wp--preset--color--*) or --gs-*)" }],
    "declaration-property-value-disallowed-list": {
      "font-size": ["/^\\d+px$/"],
      "/^(margin|padding|gap)/": ["/^\\d{2,}px$/"]
    }
  },
  "overrides": [{ "files": ["**/components.css"], "rules": {} }]
}
