<?xml version="1.0"?>
<ruleset name="House Standards">
  <file>wp-content/themes/gorilla-security</file>
  <file>wp-content/mu-plugins</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <config name="testVersion" value="7.4-"/>
  <config name="minimum_wp_version" value="6.6"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="gorilla-security"/></property></properties>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties><property name="prefixes" type="array"><element value="gs"/></property></properties>
  </rule>
  <!-- Project hooks use gs/{name} (docs/project-context.md). -->
  <rule ref="WordPress.NamingConventions.ValidHookName">
    <properties><property name="additionalWordDelimiters" value="/"/></properties>
  </rule>
</ruleset>
