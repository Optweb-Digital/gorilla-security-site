{
  "name": "gorilla-security-site",
  "private": true,
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:reset": "wp-env clean all && wp-env run cli wp import /var/www/html/fixtures/content.xml --authors=create",
    "lint:style": "wp-scripts lint-style \"wp-content/**/*.css\" && wp-scripts lint-js \"wp-content/**/*.js\"",
    "fix:style": "wp-scripts lint-style \"wp-content/**/*.css\" --fix && wp-scripts lint-js \"wp-content/**/*.js\" --fix",
    "test:a11y": "pa11y-ci --config tests/a11y/.pa11yci.json",
    "test:perf": "lhci autorun --config=tests/perf/lighthouserc.json",
    "check": "composer run lint:php && composer run lint:security && npm run lint:style && npm run test:a11y && npm run test:perf"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14",
    "@wordpress/env": "^10",
    "@wordpress/scripts": "^30",
    "pa11y-ci": "^3",
    "typescript": "^5.9.3"
  }
}
